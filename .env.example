# ═══════════════════════════════════════════════════════
#  Smart City Infrastructure Monitoring Platform
#  Environment Configuration Template
# ═══════════════════════════════════════════════════════

# ═══ Platform ═══
APP_NAME=SmartCity-Platform
APP_ENV=development
APP_PORT=8000
SECRET_KEY=change-me-to-a-secure-random-string
CORS_ORIGINS=http://localhost:5173

# ═══ Database ═══
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartcity
POSTGIS_ENABLED=true

# ═══ AI Runtime ═══
AI_RUNTIME=pytorch
AI_MODEL_PATH=models/best.pt
AI_ONNX_MODEL_PATH=models/best.onnx
AI_CONFIDENCE_THRESHOLD=0.5
AI_IOU_THRESHOLD=0.45
AI_INFERENCE_RESOLUTION=640
AI_MAX_INFERENCE_FPS=15

# ═══ Tracking ═══
TRACKER_TYPE=bytetrack
TRACKER_CONFIRM_FRAMES=5

# ═══ Incident ═══
INCIDENT_SPATIAL_DEDUP_METERS=10
INCIDENT_TEMPORAL_DEDUP_SECONDS=30
INCIDENT_COOLDOWN_SECONDS=60

# ═══ Alerts ═══
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_ENABLED=false
ALERT_RECIPIENT_EMAILS=

# ═══ Resource Limits ═══
MAX_CONCURRENT_SESSIONS=10
MAX_WEBSOCKET_CONNECTIONS=50
MAX_FRAME_QUEUE_SIZE=3
MAX_VIDEO_RESOLUTION=1280x720
